# Local-only values. Replace the Django key with a generated random value.
DJANGO_SECRET_KEY=replace-with-a-random-local-only-key
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_HSTS_SECONDS=0

POSTGRES_DB=dairyfarm
POSTGRES_USER=dairyfarm
POSTGRES_PASSWORD=replace-with-a-local-only-password
